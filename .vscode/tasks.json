{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++-15 build active file",
            // "command": "/opt/homebrew/bin/g++-15",
            "command": "g++",
            "args": [
                "-std=c++23",
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                // "${fileDirname}/${fileBasenameNoExtension}"
                "${workspaceFolder}/bin/a.out"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "shell",
            "label": "run to file",
            "command": "${workspaceFolder}/bin/a.out",
            "args": [
                "<",
                "${workspaceFolder}/bin/#input.txt",
                ">",
                "${workspaceFolder}/bin/#output.txt"
            ],
            "dependsOn": "C/C++: g++-15 build active file", // Compile first
            "group": "test"
        }
    ],
    "version": "2.0.0"
}