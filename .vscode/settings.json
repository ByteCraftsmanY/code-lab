{
    "window.zoomLevel": 0.8,
    "editor.fontFamily": "JetBrains Mono", //"Menlo",
    "editor.fontSize": 16,
    "editor.lineHeight": 1.5,
    "editor.formatOnSave": true,
    "terminal.integrated.fontFamily": "Monaco",
    "terminal.integrated.fontSize": 13,
    "files.autoSave": "afterDelay",
    "C_Cpp.default.cStandard": "c11",
    "C_Cpp.default.cppStandard": "c++11",
    "C_Cpp.default.intelliSenseMode": "linux-gcc-x64",
    // "C_Cpp.default.compilerPath": "/opt/homebrew/bin/g++-15",
    "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: Google, IndentWidth: 4, ColumnLimit: 0}",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/**"
    ],
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "code-runner.executorMap": {
        "c": "cd $dir && export mydir=$workspaceRoot/bin && gcc -std=c11 $fileName -o $mydir/a.out && $mydir/a.out < $mydir/'#input.txt' > $mydir'/#output.txt'",
        "cpp": "cd $dir && export mydir=$workspaceRoot/bin && g++ -std=c++11 $fileName -o $mydir/a.out && $mydir/a.out < $mydir/'#input.txt' > $mydir'/#output.txt'",
        "java": "cd $dir && javac -d $workspaceRoot/bin $fileName && java -cp $workspaceRoot/bin $fileNameWithoutExt",
    },
    "[code-runner-output]": {
        "editor.fontSize": 14,
        "editor.fontFamily": "Monaco, 'Courier New', monospace",
        "editor.lineHeight": 1.2,
    },
    "search.exclude": {
        "**/build": true,
        "**/bin": true,
        "**/.git": true
    },
    "chat.agent.enabled": false,
}